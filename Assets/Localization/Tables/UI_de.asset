%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: UI_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 9202a1d308e98e942987d694bc562658, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1045303296
    m_Localized: Aufgabe
    m_Metadata:
      m_Items: []
  - m_Id: 1112412160
    m_Localized: Frage {n} von {total}
    m_Metadata:
      m_Items: []
  - m_Id: 7615867129856
    m_Localized: Teilnehmercode eingeben
    m_Metadata:
      m_Items: []
  - m_Id: 7615938433024
    m_Localized: "L\xF6schen"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627328
    m_Localized: OK
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627329
    m_Localized: "Testmodus \u2013 wird nicht ausgewertet"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627330
    m_Localized: Ist der Code {participant_id} richtig?
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627331
    m_Localized: Korrigieren
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627332
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627333
    m_Localized: Kurs von {participant_id} fortsetzen?
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627334
    m_Localized: 'Unterbrochen in: {scene_name}'
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627335
    m_Localized: Fortsetzen
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627336
    m_Localized: Neu beginnen
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627337
    m_Localized: "F\xFCr {participant_id} gibt es bereits eine abgeschlossene Sitzung."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627338
    m_Localized: Trotzdem starten
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627339
    m_Localized: Die Sitzung konnte nicht gestartet werden. Bitte starten Sie die
      App neu.
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627340
    m_Localized: Bitte nehmen Sie die VR-Brille ab und melden Sie sich bei der Kursleitung.
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627341
    m_Localized: 'Code: {participant_id}'
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627342
    m_Localized: "1.\_Einf\xFChrung"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627343
    m_Localized: "2.\_Grundlagen"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627344
    m_Localized: "3.\_Kommissionieren nach EKZ 3"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627345
    m_Localized: "4.\_Mehrere Positionen"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627346
    m_Localized: "5.\_Volle Kartons und loses Material"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627347
    m_Localized: Sitzung wirklich beenden?
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627348
    m_Localized: Fortsetzen
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627349
    m_Localized: Beenden
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627350
    m_Localized: Kommissionieren Sie den Auftrag, der im Lagerverwaltungssystem (LVS)
      angezeigt wird.
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627351
    m_Localized: 1. Angaben im LVS ablesen
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627352
    m_Localized: "Lesen Sie im LVS ab: Materialnummer (<nobr>Mat.-Nr</nobr>), Sollmenge
      (Soll), VPE (<nobr>Verp.-Einh.</nobr>), EKZ (<nobr>Empf Kz</nobr>). Rest: So
      viele St\xFCck bleiben nach dem Auftrag im Lagerbeh\xE4lter."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627353
    m_Localized: 2. Kartons kommissionieren
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627354
    m_Localized: "Rechnen Sie aus, wie viele Kartons Sie brauchen. Legen Sie die
      Kartons nach der EKZ in den Auftragsbeh\xE4lter."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627355
    m_Localized: "3. Auftrag best\xE4tigen"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627356
    m_Localized: "Pr\xFCfen Sie im LVS, ob Ist und Soll gleich sind. Dr\xFCcken Sie
      dann den roten Knopf (F6)."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627357
    m_Localized: Richtig!
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627358
    m_Localized: "Der Auftrag ist richtig.\nDer Auftragsbeh\xE4lter wechselt auf
      die mittlere Bahn und f\xE4hrt weg.\nW\xE4hlen Sie jetzt im Men\xFC \u201E4.\_Mehrere
      Positionen\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627359
    m_Localized: Nicht richtig
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627360
    m_Localized: "Der Auftrag ist nicht richtig. Pr\xFCfen Sie die Angaben im LVS
      und versuchen Sie es noch einmal."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627361
    m_Localized: F6
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627362
    m_Localized: "Kartons im Auftragsbeh\xE4lter: {placed}"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627363
    m_Localized: "Der Auftragsbeh\xE4lter ist leer. Legen Sie das Material des Auftrags
      hinein."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627364
    m_Localized: "Im Auftragsbeh\xE4lter liegt falsches Material. Nehmen Sie es heraus.
      Pr\xFCfen Sie die Materialnummer im LVS."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627365
    m_Localized: 'Zu wenig Material {name}. Rechnen Sie nach: Sollmenge geteilt durch
      VPE.'
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627366
    m_Localized: 'Zu viel Material {name}. Rechnen Sie nach: Sollmenge geteilt durch
      VPE.'
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627367
    m_Localized: "Zu wenig loses Material {name}. Rechnen Sie nach: Sollmenge minus
      St\xFCckzahl der vollen Kartons."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627368
    m_Localized: "Zu viel loses Material {name}. Rechnen Sie nach: Sollmenge minus
      St\xFCckzahl der vollen Kartons."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627369
    m_Localized: Es gibt noch weitere Fehler.
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627370
    m_Localized: Nicht richtig
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627371
    m_Localized: "Alle Materialien und Mengen stimmen mit dem Auftrag \xFCberein.\nDer
      Auftragsbeh\xE4lter wechselt auf die mittlere Bahn und f\xE4hrt weg.\nW\xE4hlen
      Sie jetzt im Men\xFC \u201E{next_lesson}\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627372
    m_Localized: "Volle Kartons und loses Material stimmen mit dem Auftrag \xFCberein.\nDer
      Auftragsbeh\xE4lter wechselt auf die mittlere Bahn und f\xE4hrt weg."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627373
    m_Localized: Lernen Sie das Etikett und das Lagerverwaltungssystem (LVS) kennen.
      Beantworten Sie dann die Fragen.
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627374
    m_Localized: 1. Etikett lesen
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627375
    m_Localized: Nehmen Sie jede Verpackung in die Hand und lesen Sie ihr Etikett.
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627376
    m_Localized: 2. LVS kennenlernen
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627377
    m_Localized: "Lesen Sie die Erkl\xE4rung neben dem Feld. Dr\xFCcken Sie \u201EWeiter\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627378
    m_Localized: 3. Fragen beantworten
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627379
    m_Localized: "Die Fragen kommen nach der Erkl\xE4rung zum LVS. Dr\xFCcken Sie
      dann A, B oder C."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627381
    m_Localized: 1. Etikett lesen
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627382
    m_Localized: Nehmen Sie eine Verpackung in die Hand. Hier sehen Sie, was auf
      dem Etikett steht.
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627383
    m_Localized: "Mat.-Nr: {matnr} \u2013 die Materialnummer. Dieselbe Nummer steht
      im LVS."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627384
    m_Localized: "VPE: {vpe} ST \u2013 so viele St\xFCck sind in dieser Verpackung."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627385
    m_Localized: Weiter
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627386
    m_Localized: Von vorn
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627387
    m_Localized: Schritt {n} von {total}
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627388
    m_Localized: Das LVS
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627389
    m_Localized: Hier sehen Sie einen Auftrag im Lagerverwaltungssystem (LVS).
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627390
    m_Localized: Mat.-Nr und Bez.
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627391
    m_Localized: Materialnummer und Bezeichnung.
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627392
    m_Localized: Verp.-Einh.
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627393
    m_Localized: "St\xFCck pro Karton, auf dem Etikett steht daf\xFCr VPE."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627394
    m_Localized: Soll
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627395
    m_Localized: "So viele St\xFCck m\xFCssen Sie kommissionieren."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627396
    m_Localized: Ist
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627397
    m_Localized: "Beim Wiegen zeigt Ist, wie viele St\xFCck schon im Auftragsbeh\xE4lter
      liegen."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627398
    m_Localized: Rest
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627399
    m_Localized: "So viele St\xFCck bleiben nach dem Auftrag im Lagerbeh\xE4lter."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627400
    m_Localized: Empf Kz
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627401
    m_Localized: 'Hier steht, wie Sie die Teile einlegen: 003 ist EKZ 3, also einzeln
      und geordnet.'
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627402
    m_Localized: 'Anderer Wert: Empf Kz 000'
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627403
    m_Localized: "Bei anderen Auftr\xE4gen kann hier 000 stehen, also EKZ 0: Die
      Teile d\xFCrfen ungeordnet liegen oder eingef\xFCllt werden."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627404
    m_Localized: "Nicht in der \xDCbung"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627405
    m_Localized: Die markierten Bereiche brauchen Sie hier nicht. Das Feld Anweisung
      bleibt leer.
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627407
    m_Localized: <color=#27AE60><b>Richtig!</b></color>
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627408
    m_Localized: "Beantworten Sie jetzt die n\xE4chste Frage."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627409
    m_Localized: "Sie haben alle Fragen richtig beantwortet. W\xE4hlen Sie jetzt
      im Men\xFC \u201E{lesson}\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627410
    m_Localized: <color=#EB5757><b>Nicht richtig</b></color>
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627411
    m_Localized: 'Soll 100, VPE 25: Wie viele Kartons nehmen Sie?'
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627415
    m_Localized: Welches Material hat die Mat.-Nr 738190?
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627417
    m_Localized: "Empf Kz 003: Wie geben Sie die Teile in den Auftragsbeh\xE4lter?"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627418
    m_Localized: Einzeln und geordnet einlegen
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627419
    m_Localized: "Ungeordnet einf\xFCllen"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627420
    m_Localized: "Empf Kz 000: Wie d\xFCrfen Sie die Teile in den Auftragsbeh\xE4lter
      geben?"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627421
    m_Localized: Nur einzeln und geordnet einlegen
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627422
    m_Localized: "Einf\xFCllen ist erlaubt"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627423
    m_Localized: "Lesen Sie im LVS ab: Materialnummer (Mat.-Nr), Sollmenge (Soll),
      VPE (Verp.-Einh.), EKZ (Empf Kz). Rest: So viele St\xFCck bleiben nach dem
      Auftrag im Lagerbeh\xE4lter."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627424
    m_Localized: "\xDCben Sie zwei einfache Handgriffe."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627425
    m_Localized: 1. Karton greifen
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627426
    m_Localized: Greifen Sie mit einer Hand nach dem Karton und heben Sie ihn hoch.
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627427
    m_Localized: "2. Knopf dr\xFCcken"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627428
    m_Localized: "Dr\xFCcken Sie mit der Fingerspitze den roten Knopf. Sp\xE4ter
      best\xE4tigen Sie damit den Auftrag."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627429
    m_Localized: Willkommen bei <color=#0391DD>XPick!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627430
    m_Localized: "Ein VR-Training f\xFCr die Kommissionierung im Lager"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627431
    m_Localized: Das lernen Sie
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627432
    m_Localized: "Am Ende des Kurses k\xF6nnen Sie:\n\u2022 einen Auftrag im Lagerverwaltungssystem
      (LVS) ablesen\n\u2022 das Etikett mit dem LVS vergleichen (Mat.-Nr, VPE)\n\u2022
      volle Kartons und lose Teile berechnen\n\u2022 Kartons nach EKZ einlegen\n\u2022
      mehrere Positionen nacheinander kommissionieren"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627433
    m_Localized: 'Dauer: etwa 5 Minuten pro Lektion'
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627434
    m_Localized: Ihre Aufgaben stehen links auf den Karten.
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627435
    m_Localized: "Danach w\xE4hlen Sie im Men\xFC die n\xE4chste Lektion."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627436
    m_Localized: Kommissionieren Sie den Auftrag, der im Lagerverwaltungssystem (LVS)
      angezeigt wird. Bearbeiten Sie die zwei Positionen nacheinander.
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627437
    m_Localized: "Lesen Sie f\xFCr die aktuelle Position ab: Materialnummer (<nobr>Mat.-Nr</nobr>),
      Sollmenge (Soll), VPE (<nobr>Verp.-Einh.</nobr>) und EKZ (<nobr>Empf Kz</nobr>)."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627438
    m_Localized: 2. Material kommissionieren
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627439
    m_Localized: "Rechnen Sie aus, wie viele Verpackungen Sie brauchen. Legen Sie
      die Verpackungen in den Auftragsbeh\xE4lter."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627440
    m_Localized: "Pr\xFCfen Sie im LVS, ob Ist und Soll gleich sind. Dr\xFCcken Sie
      dann den roten Knopf (F6)."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627441
    m_Localized: Kommissionieren Sie den Auftrag, der im Lagerverwaltungssystem (LVS)
      angezeigt wird. Der Auftrag hat zwei Positionen mit losem Material. Bearbeiten
      Sie beide nacheinander.
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627442
    m_Localized: 'Lesen Sie im LVS ab: Materialnummer (<nobr>Mat.-Nr</nobr>), Sollmenge
      (Soll), VPE (<nobr>Verp.-Einh.</nobr>) und EKZ (<nobr>Empf Kz</nobr>).'
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627443
    m_Localized: "Rechnen Sie aus, wie viele volle Kartons und lose Teile Sie brauchen.
      Legen Sie zuerst die Kartons, dann die losen Teile in den Auftragsbeh\xE4lter."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627444
    m_Localized: "Z\xE4hlen Sie die vollen Kartons und die losen Teile nach. Pr\xFCfen
      Sie im LVS, ob Ist und Soll gleich sind. Dr\xFCcken Sie dann den roten Knopf
      (F6)."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627445
    m_Localized: "Herzlichen Gl\xFCckwunsch!"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627446
    m_Localized: Das haben Sie gelernt
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627447
    m_Localized: "\u2022 Einen Auftrag im LVS ablesen\n\u2022 Das Etikett mit dem
      LVS vergleichen (Mat.-Nr, VPE)\n\u2022 Volle Kartons und lose Teile berechnen\n\u2022
      Kartons nach EKZ einlegen\n\u2022 Mehrere Positionen nacheinander kommissionieren\n\u2022
      Der rote Knopf steht f\xFCr das Best\xE4tigen mit dem Fu\xDF"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627448
    m_Localized: "Position {position} ist erledigt.\nDer Lagerbeh\xE4lter f\xE4hrt
      weg, der n\xE4chste kommt von links.\nLesen Sie dann im LVS die Angaben von
      Position {next_position} ab."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627449
    m_Localized: 'Nicht alle Kartons liegen geordnet. Bei Empf Kz 003: Legen Sie
      die Kartons einzeln und geordnet ein.'
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627450
    m_Localized: "Weg der Beh\xE4lter"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627451
    m_Localized: "Der Lagerbeh\xE4lter kommt von links und f\xE4hrt \xFCber die mittlere
      Bahn weg; der Auftragsbeh\xE4lter f\xE4hrt erst weg, wenn der Auftrag erledigt
      ist. In der Praxis bewegen Sie die Beh\xE4lter von Hand."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627452
    m_Localized: "Wie viele volle Kartons nehmen Sie f\xFCr diese Position?"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627453
    m_Localized: "Wie viele lose Teile nehmen Sie zus\xE4tzlich?"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627454
    m_Localized: 1 Karton
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627455
    m_Localized: '{count} Kartons'
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627456
    m_Localized: 1 Teil
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627457
    m_Localized: '{count} Teile'
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627458
    m_Localized: "<color=#EB5757><b>Nicht richtig.</b></color> Teilen Sie Soll durch
      VPE. Es z\xE4hlen nur volle Kartons."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627459
    m_Localized: "<color=#EB5757><b>Nicht richtig.</b></color> Lose Teile = Soll
      minus (volle Kartons \xD7 VPE)."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627460
    m_Localized: <color=#27AE60><b>Richtig!</b></color> Beantworten Sie jetzt die
      zweite Frage.
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627461
    m_Localized: "<color=#27AE60><b>Richtig!</b></color> Nehmen Sie jetzt die vollen
      Kartons und die losen Teile aus dem Lagerbeh\xE4lter."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627462
    m_Localized: Beispiel
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627463
    m_Localized: "Soll 64 ST, VPE 20 ST\n1. 64 : 20 = 3,2 \u2013 also 3 volle Kartons
      (60 ST)\n2. 64 - 60 = 4 lose Teile\nKontrolle: 60 + 4 = 64 ST"
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627464
    m_Localized: "Position {done} ist erledigt.\nDer angebrochene Karton mit der
      Anbruchmenge bleibt im Modul im Lagerbeh\xE4lter.\nLesen Sie im LVS die Angaben
      von Position {next} ab."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627465
    m_Localized: "Legen Sie zuerst die vollen Kartons, dann die losen Teile aus dem
      angebrochenen Karton in den Auftragsbeh\xE4lter."
    m_Metadata:
      m_Items: []
  - m_Id: 7615942627466
    m_Localized: "Lesen Sie im LVS ab: Materialnummer (<nobr>Mat.-Nr</nobr>), Sollmenge
      (Soll), VPE (<nobr>Verp.-Einh.</nobr>) und EKZ (<nobr>Empf Kz</nobr>). Beantworten
      Sie dann die Fragen unter dem Bildschirm. Das \u201EBeispiel\u201C direkt darunter
      hilft beim Rechnen."
    m_Metadata:
      m_Items: []
  - m_Id: 15832974233600
    m_Localized: "MEN\xDC"
    m_Metadata:
      m_Items: []
  - m_Id: 33687593684992
    m_Localized: 2 Kartons
    m_Metadata:
      m_Items: []
  - m_Id: 33687669182464
    m_Localized: "2 Kartons sind nur 50 St\xFCck."
    m_Metadata:
      m_Items: []
  - m_Id: 33687669182465
    m_Localized: 4 Kartons
    m_Metadata:
      m_Items: []
  - m_Id: 33687669182466
    m_Localized: 25 Kartons
    m_Metadata:
      m_Items: []
  - m_Id: 33687669182467
    m_Localized: "25 ist die VPE: die St\xFCckzahl in einem Karton. Teilen Sie Soll
      durch VPE."
    m_Metadata:
      m_Items: []
  - m_Id: 33687669182468
    m_Localized: KABELVERBINDER A
    m_Metadata:
      m_Items: []
  - m_Id: 33687669182469
    m_Localized: SCHRAUBE B
    m_Metadata:
      m_Items: []
  - m_Id: 33687669182470
    m_Localized: RING D
    m_Metadata:
      m_Items: []
  - m_Id: 33687669182471
    m_Localized: Vergleichen Sie die Mat.-Nr auf den Etiketten mit 738190.
    m_Metadata:
      m_Items: []
  - m_Id: 33687669182472
    m_Localized: Vergleichen Sie die Mat.-Nr auf den Etiketten mit 738190.
    m_Metadata:
      m_Items: []
  - m_Id: 33687669182473
    m_Localized: "Bei 003 m\xFCssen die Teile einzeln und geordnet liegen."
    m_Metadata:
      m_Items: []
  - m_Id: 33687669182474
    m_Localized: "Bei 000 d\xFCrfen die Teile ungeordnet liegen."
    m_Metadata:
      m_Items: []
  - m_Id: 287914819719168
    m_Localized: "EKZ-\xDCbersicht"
    m_Metadata:
      m_Items: []
  - m_Id: 287914874245120
    m_Localized: "In der \xDCbung"
    m_Metadata:
      m_Items: []
  - m_Id: 287914874245121
    m_Localized: "Ungeordnet einf\xFCllen ist erlaubt."
    m_Metadata:
      m_Items: []
  - m_Id: 287914874245122
    m_Localized: Von Hand einlegen, auch mehrere auf einmal.
    m_Metadata:
      m_Items: []
  - m_Id: 287914874245123
    m_Localized: Einzeln und geordnet einlegen.
    m_Metadata:
      m_Items: []
  - m_Id: 287914874245124
    m_Localized: Wie EKZ 3, Teile in einer Ebene mit Zwischenlage trennen.
    m_Metadata:
      m_Items: []
  - m_Id: 287914874245125
    m_Localized: Wie EKZ 3, Teile in zwei Ebenen mit Zwischenlage trennen.
    m_Metadata:
      m_Items: []
  - m_Id: 287914874245126
    m_Localized: Wie EKZ 3, Teile in allen Ebenen mit Zwischenlage trennen.
    m_Metadata:
      m_Items: []
  - m_Id: 287914874245127
    m_Localized: "ESD-gesch\xFCtzte Teile. Nicht ohne Anweisung \xF6ffnen."
    m_Metadata:
      m_Items: []
  - m_Id: 287914874245128
    m_Localized: "Sonderverpackung. Nicht ohne Anweisung \xF6ffnen."
    m_Metadata:
      m_Items: []
  - m_Id: 336383051698176
    m_Localized: Beantworten Sie zuerst die Fragen unter dem Bildschirm.
    m_Metadata:
      m_Items: []
  - m_Id: 340851944198144
    m_Localized: Anzahl Kartons
    m_Metadata:
      m_Items: []
  - m_Id: 340852011307008
    m_Localized: = 3 Kartons
    m_Metadata:
      m_Items: []
  - m_Id: 340852011307009
    m_Localized: "Die Fragen kommen nach der Erkl\xE4rung zum LVS."
    m_Metadata:
      m_Items: []
  - m_Id: 340852011307010
    m_Localized: "Dr\xFCcken Sie A, B oder C, um zu antworten."
    m_Metadata:
      m_Items: []
  - m_Id: 340852011307011
    m_Localized: Ablauf am Kommissionierplatz
    m_Metadata:
      m_Items: []
  - m_Id: 340852011307012
    m_Localized: "Lagerbeh\xE4lter kommt an"
    m_Metadata:
      m_Items: []
  - m_Id: 340852011307013
    m_Localized: "Beh\xE4lter fahren weg"
    m_Metadata:
      m_Items: []
  - m_Id: 340852011307014
    m_Localized: "Auftragsbeh\xE4lter"
    m_Metadata:
      m_Items: []
  - m_Id: 340852011307015
    m_Localized: "Das \xFCben Sie hier"
    m_Metadata:
      m_Items: []
  - m_Id: 340852011307016
    m_Localized: "In der \xDCbung automatisch"
    m_Metadata:
      m_Items: []
  - m_Id: 340852011307018
    m_Localized: Auftrag im LVS ablesen
    m_Metadata:
      m_Items: []
  - m_Id: 340852011307019
    m_Localized: "Teile z\xE4hlen"
    m_Metadata:
      m_Items: []
  - m_Id: 340852011307020
    m_Localized: "Teile in den Auftragsbeh\xE4lter legen"
    m_Metadata:
      m_Items: []
  - m_Id: 340852011307021
    m_Localized: "Best\xE4tigen (F6)"
    m_Metadata:
      m_Items: []
  - m_Id: 340852011307022
    m_Localized: "Lagerbeh\xE4lter von links heranziehen \u2013 am echten Platz von
      Hand"
    m_Metadata:
      m_Items: []
  - m_Id: 340852011307023
    m_Localized: "Leeren Auftragsbeh\xE4lter von rechts heranziehen \u2013 am echten
      Platz von Hand"
    m_Metadata:
      m_Items: []
  - m_Id: 340852011307024
    m_Localized: "Lagerbeh\xE4lter f\xE4hrt weg, der n\xE4chste kommt von links"
    m_Metadata:
      m_Items: []
  - m_Id: 340852011307025
    m_Localized: "Auftragsbeh\xE4lter auf die mittlere Bahn ziehen \u2013 am echten
      Platz von Hand"
    m_Metadata:
      m_Items: []
  - m_Id: 340852011307026
    m_Localized: Teile wiegen
    m_Metadata:
      m_Items: []
  - m_Id: 340852011307027
    m_Localized: Teile vorverpacken
    m_Metadata:
      m_Items: []
  - m_Id: 340852011307028
    m_Localized: "Restmenge im Lagerbeh\xE4lter sichern"
    m_Metadata:
      m_Items: []
  - m_Id: 340852011307029
    m_Localized: "Leere Kartons aus dem Lagerbeh\xE4lter entfernen"
    m_Metadata:
      m_Items: []
  - m_Id: 346260058804224
    m_Localized: "Pr\xFCfen Sie im LVS, ob Ist und Soll gleich sind. Dr\xFCcken Sie
      dann den roten Knopf (F6). Danach zeigt das LVS Position 2 an."
    m_Metadata:
      m_Items: []
  - m_Id: 346260226576384
    m_Localized: "Z\xE4hlen Sie die vollen Kartons und die losen Teile nach. Pr\xFCfen
      Sie im LVS, ob Ist und Soll gleich sind. Dr\xFCcken Sie dann den roten Knopf
      (F6). Danach f\xE4hrt der Lagerbeh\xE4lter weg, der n\xE4chste kommt von links.
      Das LVS zeigt Position 2 an."
    m_Metadata:
      m_Items: []
  - m_Id: 350226641457152
    m_Localized: Richtig!
    m_Metadata:
      m_Items: []
  - m_Id: 652255544872960
    m_Localized: "Zur\xFCck"
    m_Metadata:
      m_Items: []
  - m_Id: 663146915041280
    m_Localized: "Lagerbeh\xE4lter"
    m_Metadata:
      m_Items: []
  - m_Id: 663146990538752
    m_Localized: Mittlere Bahn
    m_Metadata:
      m_Items: []
  - m_Id: 663146990538753
    m_Localized: "Auftragsbeh\xE4lter"
    m_Metadata:
      m_Items: []
  - m_Id: 668799050059776
    m_Localized: "Dr\xFCcken Sie A, B oder C, um zu antworten."
    m_Metadata:
      m_Items: []
  - m_Id: 727156674924544
    m_Localized: "Dr\xFCcken Sie \u201EWeiter\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 727156758810624
    m_Localized: Nehmen Sie den Karton STECKER C in die Hand.
    m_Metadata:
      m_Items: []
  - m_Id: 727156758810625
    m_Localized: Nehmen Sie den Karton STECKER C in die Hand.
    m_Metadata:
      m_Items: []
  - m_Id: 727156758810626
    m_Localized: "Lesen Sie die Zahl im Feld Soll ab. Dr\xFCcken Sie dann \u201EWeiter\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 727156758810627
    m_Localized: "Schauen Sie in den Auftragsbeh\xE4lter rechts."
    m_Metadata:
      m_Items: []
  - m_Id: 727156758810628
    m_Localized: "Dr\xFCcken Sie \u201EWeiter\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 727156758810629
    m_Localized: "Dr\xFCcken Sie \u201EWeiter\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 727156758810630
    m_Localized: "Sehen Sie sich das Beispiel \u201EEmpf Kz 003\u201C zwischen den
      Beh\xE4ltern an."
    m_Metadata:
      m_Items: []
  - m_Id: 727156758810631
    m_Localized: "Vergleichen Sie die beiden Beispiele zwischen den Beh\xE4ltern."
    m_Metadata:
      m_Items: []
  - m_Id: 727156758810632
    m_Localized: "Dr\xFCcken Sie \u201EWeiter\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 727156763004928
    m_Localized: "Sehen Sie den Beh\xE4ltern auf der Rollenbahn zu. Beantworten Sie
      dann die Fragen unter dem Bildschirm."
    m_Metadata:
      m_Items: []
